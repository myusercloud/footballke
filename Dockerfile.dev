# ── Development image ─────────────────────────────────────────────────────────
# Runs `next dev` with the source tree mounted as a volume.
# node_modules lives in a named volume so the Linux-built modules are never
# overwritten by the host's (Windows/Mac) modules.

FROM node:20-alpine

# Install libc compatibility shims needed by some native addons on Alpine.
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy manifests first so the install layer is cached independently of source.
COPY package.json package-lock.json* ./

# Install all dependencies (including devDependencies — required for next dev).
RUN npm ci

# The source tree is mounted at run time via docker-compose volume.
# This COPY is intentionally omitted — it would be shadowed by the bind mount.

EXPOSE 3000

# next dev binds to 0.0.0.0 so it is reachable from outside the container.
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
